/**
 * Variáveis de ambiente - Copiar para .env.local
 * 
 * VITE_SUPABASE_URL=https://your-project.supabase.co
 * VITE_SUPABASE_ANON_KEY=your-anon-key-here
 * 
 * A tabela "patients" já existe no Supabase com os seguintes campos:
 * - id (uuid)
 * - name (text)
 * - bed_number (integer)
 * - mother_name (text)
 * - dob (date)
 * - diagnosis (text)
 * - status (varchar) - estavel, instavel, em_risco
 * - comorbidade (text)
 * - dt_internacao (date)
 * - peso (numeric)
 * - destino (text)
 * - created_at (timestamp)
 * - updated_at (timestamp)
 * - nomepaciente_norm (text) - gerado automaticamente
 */
